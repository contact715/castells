{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "castells.media"
        }
      ],
      "destination": "https://www.castells.media/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "academy.castells.media"
        }
      ],
      "destination": "https://www.castells.media/academy/$1",
      "permanent": false
    },
    {
      "source": "/case-studies",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/industries/adu-&-additions",
      "destination": "/industries/adu-and-additions",
      "permanent": true
    },
    {
      "source": "/industries/fencing-&-gates",
      "destination": "/industries/fencing-and-gates",
      "permanent": true
    },
    {
      "source": "/industries/flooring-&-tile",
      "destination": "/industries/flooring-and-tile",
      "permanent": true
    },
    {
      "source": "/industries/int/ext-painting",
      "destination": "/industries/int-ext-painting",
      "permanent": true
    },
    {
      "source": "/academy/before-you-spend-on-marketing",
      "destination": "/academy/contractors/before-you-spend-on-marketing",
      "permanent": true
    },
    {
      "source": "/academy/what-a-brand-is-for-a-contractor",
      "destination": "/academy/contractors/what-a-brand-is-for-a-contractor",
      "permanent": true
    },
    {
      "source": "/academy/three-kinds-of-website",
      "destination": "/academy/contractors/three-kinds-of-website",
      "permanent": true
    },
    {
      "source": "/academy/where-the-marketing-money-goes",
      "destination": "/academy/contractors/where-the-marketing-money-goes",
      "permanent": true
    },
    {
      "source": "/academy/how-people-find-a-contractor",
      "destination": "/academy/contractors/how-people-find-a-contractor",
      "permanent": true
    },
    {
      "source": "/academy/the-job-you-lose",
      "destination": "/academy/contractors/the-job-you-lose",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/auth/thumbtack/callback",
      "destination": "/api/thumbtack.py"
    },
    {
      "source": "/webhook/thumbtack/:path*",
      "destination": "/api/thumbtack.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/lead-form",
      "destination": "/api/lead-form.js"
    },
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/whatsapp-webhook.js"
    },
    {
      "source": "/api/telegram-webhook",
      "destination": "/api/telegram-webhook.js"
    },
    {
      "source": "/team/:path*",
      "destination": "/index.html"
    }
  ]
}
