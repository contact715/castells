{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/auth/thumbtack/callback",
      "dest": "/api/thumbtack.py"
    },
    {
      "src": "/webhook/thumbtack/(.*)",
      "dest": "/api/thumbtack.py"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    },
    {
      "src": "/api/lead-form",
      "dest": "/api/lead-form.js"
    },
    {
      "src": "/api/whatsapp-webhook",
      "dest": "/api/whatsapp-webhook.js"
    },
    {
      "src": "/api/telegram-webhook",
      "dest": "/api/telegram-webhook.js"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "castells.media"
        }
      ],
      "headers": {
        "Location": "https://www.castells.media/$1"
      },
      "status": 308
    },
    {
      "src": "/blog/(4|5|6|7|8|9)",
      "status": 301,
      "headers": {
        "Location": "/blog"
      }
    },
    {
      "src": "/case-studies",
      "status": 301,
      "headers": {
        "Location": "/work"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/team/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/careers",
      "status": 301,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/company",
      "status": 301,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
